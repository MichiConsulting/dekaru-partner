# Verbindung zur Postgres-Datenbank (Neon). Ohne diesen Wert laeuft lokal PGlite.
# DATABASE_URL=postgres://benutzer:passwort@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Nur lokal: Ordner, in dem PGlite die Daten ablegt. Ohne Wert bleibt alles im Speicher.
PGLITE_PFAD=./.pglite
