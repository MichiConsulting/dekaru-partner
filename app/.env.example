# Verbindung zur Postgres-Datenbank (Neon). Ohne diesen Wert laeuft lokal PGlite.
# DATABASE_URL=postgres://benutzer:passwort@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Nur lokal: Ordner, in dem PGlite die Daten ablegt. Ohne Wert bleibt alles im Speicher.
PGLITE_PFAD=./.pglite

# Import per Skript (POST /api/provision-import). Mindestens 32 Zeichen, erzeugen
# mit: openssl rand -hex 32. Echter Wert nur bei Vercel, nie in eine Datei.
# PROVISION_IMPORT_TOKEN=

# Mail an den Vertriebler nach einem Import, dieselben Einstellungen wie der
# Formulardienst (Google Workspace SMTP-Relay). Ohne diese Werte keine Mail.
# PORTAL_SMTP_HOST=smtp-relay.gmail.com
# PORTAL_SMTP_PORT=587
# Port 465 ist immer TLS von Anfang an, jeder andere Port verlangt STARTTLS.
# PORTAL_SMTP_SECURE=false
# PORTAL_SMTP_USER=
# PORTAL_SMTP_PASS=
# PORTAL_SMTP_FROM=
