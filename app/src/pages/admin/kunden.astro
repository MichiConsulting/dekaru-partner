---
import Layout from '../../layouts/Layout.astro';
import { STATUS, alleKunden, statusLabel } from '../../lib/kunden.ts';
import { alleBenutzer } from '../../lib/auth.ts';
import { datumDe } from '../../lib/provision.ts';

const db = Astro.locals.db;
const status = Astro.url.searchParams.get('status') ?? '';
const benutzerId = Astro.url.searchParams.get('vertriebler') ?? '';
const kunden = await alleKunden(db, { status, benutzerId });
const vertriebler = (await alleBenutzer(db)).filter((b) => b.rolle === 'vertriebler');
---

<Layout titel="Alle Kunden" aktiv="admin">
  <p class="meta"><a href="/admin">Admin</a> / Alle Kunden</p>
  <h1>Alle Kunden</h1>
  <form method="get" class="filter">
    <div class="feld">
      <label for="vertriebler">Vertriebler</label>
      <select id="vertriebler" name="vertriebler">
        <option value="">Alle</option>
        {vertriebler.map((v) => <option value={v.id} selected={benutzerId === v.id}>{v.name}</option>)}
      </select>
    </div>
    <div class="feld">
      <label for="status">Status</label>
      <select id="status" name="status">
        <option value="">Alle</option>
        {STATUS.map((s) => <option value={s.wert} selected={status === s.wert}>{s.label}</option>)}
      </select>
    </div>
    <button type="submit" class="btn btn--zweit">Filtern</button>
  </form>
  <div class="tabelle-wrap schiebbar">
    <table>
      <thead><tr><th>Betrieb</th><th>Ort</th><th>Ansprechpartner</th><th>Status</th><th>Termin</th><th>Vertriebler</th><th>Notiz</th></tr></thead>
      <tbody>
        {kunden.length === 0 && <tr><td colspan="7">Keine Einträge.</td></tr>}
        {kunden.map((k) => (
          <tr>
            <td>{k.name}</td><td>{k.ort}</td><td>{k.ansprechpartner}{k.telefon && <span class="meta"><br />{k.telefon}</span>}</td>
            <td><span class:list={['badge', k.status === 'abschluss' && 'badge--voll']}>{statusLabel(k.status)}</span></td>
            <td>{datumDe(k.terminDatum)}</td><td>{k.vertrieblerName}</td><td style="max-width:28ch">{k.notiz}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Layout>
