---
import Layout from '../../layouts/Layout.astro';
import KundeFormular from '../../components/KundeFormular.astro';
import { STATUS_WERTE, erstelleKunde, pruefeKunde, uhrzeit, type KundeEingabe, type Status } from '../../lib/kunden.ts';
import { istIsoDatum } from '../../lib/datum.ts';
import { kalenderUrl } from '../../lib/kalender-ansicht.ts';
import { formular, istPost } from '../../lib/http.ts';
import { pruefeDublette, type TrefferAdmin } from '../../lib/dubletten.ts';
import { akteurAus, protokolliereAdminDublette } from '../../lib/admin-aktionen.ts';

const benutzer = Astro.locals.benutzer!;
const csrf = Astro.locals.csrf ?? '';
// Aus dem Kalender kommt man mit vorbelegtem Datum und Uhrzeit hierher
// (/kunden/neu?terminDatum=JJJJ-MM-TT&terminBeginn=HH:MM&status=termin).
const q = Astro.url.searchParams;
const vorDatum = q.get('terminDatum');
const vorStatus = q.get('status');
let werte: Partial<KundeEingabe> = istIsoDatum(vorDatum)
  ? {
      terminDatum: vorDatum,
      terminBeginn: uhrzeit(q.get('terminBeginn')),
      status: STATUS_WERTE.includes(vorStatus as Status) ? (vorStatus as Status) : 'termin',
    }
  : {};
// Rueckweg in den Kalender, nur in genau dieser Form (kein offener Redirect).
const KALENDER_ZURUECK = /^\/kalender\?ansicht=(monat|woche)&datum=\d{4}-\d{2}-\d{2}$/;
let zurueck: string | undefined = istIsoDatum(vorDatum) ? kalenderUrl(uhrzeit(q.get('terminBeginn')) ? 'woche' : 'monat', vorDatum) : undefined;
let fehler: string[] = [];
let adminTreffer: TrefferAdmin[] = [];

if (istPost(Astro.request)) {
  const daten = await formular(Astro.request);
  zurueck = KALENDER_ZURUECK.test(daten.zurueck ?? '') ? daten.zurueck : undefined;
  const geprueft = pruefeKunde(daten);
  werte = geprueft.wert;
  fehler = geprueft.fehler;
  if (fehler.length === 0) {
    // Gleicher Betrieb schon eingetragen? Vertriebler erfahren nur, dass es so ist.
    const dublette = await pruefeDublette(Astro.locals.db, benutzer, geprueft.wert, {
      adminFreigabe: benutzer.rolle === 'admin' && daten.dublette_freigabe === '1',
    });
    if (dublette.blockiert) {
      fehler = [dublette.meldung ?? ''];
      if (dublette.rolle === 'admin') adminTreffer = dublette.treffer;
    } else {
      const k = await erstelleKunde(Astro.locals.db, benutzer.id, geprueft.wert);
      if (dublette.rolle === 'admin' && dublette.treffer.length > 0) {
        await protokolliereAdminDublette(Astro.locals.db, akteurAus(benutzer), k, dublette.treffer.map((t) => t.id));
      }
      return Astro.redirect(zurueck && geprueft.wert.terminDatum ? `${zurueck}&ok=termin` : '/kunden?ok=neu', 303);
    }
  }
}
---

<Layout titel="Betrieb eintragen" aktiv="kunden" schmal>
  <p class="meta"><a href="/kunden">Meine Kunden</a> / Neu</p>
  <h1>Betrieb eintragen</h1>
  <KundeFormular werte={werte} csrf={csrf} fehler={fehler} knopf="Eintragen" adminTreffer={adminTreffer} zurueck={zurueck} />
</Layout>
