---
import '../styles/global.css';

interface Props {
  titel: string;
  aktiv?: 'start' | 'lernen' | 'kunden' | 'provision' | 'admin' | 'keine';
  schmal?: boolean;
}

const { titel, aktiv = 'keine', schmal = false } = Astro.props;
const benutzer = Astro.locals.benutzer;
const csrf = Astro.locals.csrf ?? '';

const punkte = benutzer
  ? [
      { key: 'start', href: '/', text: 'Start' },
      { key: 'lernen', href: '/lernen', text: 'Lernen' },
      { key: 'kunden', href: '/kunden', text: 'Meine Kunden' },
      { key: 'provision', href: '/provision', text: 'Meine Provision' },
      ...(benutzer.rolle === 'admin' ? [{ key: 'admin', href: '/admin', text: 'Admin' }] : []),
    ]
  : [];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light dark" />
    <title>{titel} | dekaru Partner-Portal</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="kopf">
      <div class="kopf__zeile">
        <a class="marke" href="/">dekaru <span>Partner-Portal</span></a>
        {
          benutzer && (
            <div class="kopf__person">
              <span class="name">{benutzer.name}</span>
              <form method="post" action="/logout" class="inline">
                <input type="hidden" name="_csrf" value={csrf} />
                <button type="submit" class="btn btn--zweit btn--klein">
                  Abmelden
                </button>
              </form>
            </div>
          )
        }
      </div>
      {
        punkte.length > 0 && (
          <nav class="nav" aria-label="Hauptnavigation">
            {punkte.map((p) => (
              <a href={p.href} aria-current={p.key === aktiv ? 'page' : undefined}>
                {p.text}
              </a>
            ))}
          </nav>
        )
      }
    </header>
    <main class:list={{ schmal }}>
      <slot />
    </main>
    <footer class="fuss">
      <div class="fuss__zeile">
        <span>dekaru Partner-Portal, Michael Henning Consulting</span>
        <a href="/datenschutz">Datenschutz</a>
      </div>
    </footer>
  </body>
</html>
