---
import '../styles/global.css';
import { darfPreiseSehen, ladeStufe } from '../lib/stufe.ts';

interface Props {
  titel: string;
  aktiv?: 'start' | 'lernen' | 'gespraech' | 'kunden' | 'kalender' | 'preisrechner' | 'briefing' | 'provision' | 'admin' | 'einstellungen' | 'keine';
  schmal?: boolean;
}

const { titel, aktiv = 'keine', schmal = false } = Astro.props;
const benutzer = Astro.locals.benutzer;
const csrf = Astro.locals.csrf ?? '';
const pfad = Astro.url.pathname.replace(/\/+$/, '') || '/';

// Der Preisrechner steht nur fuer Admin und Stufe 2 in der Navigation. Die
// Seite selbst prueft das noch einmal auf dem Server.
const preiseSichtbar = benutzer
  ? benutzer.rolle === 'admin' || darfPreiseSehen(benutzer, await ladeStufe(Astro.locals.db, benutzer.id))
  : false;

type Punkt = { key: string; href: string; text: string };
const punkte: Punkt[] = benutzer
  ? [
      { key: 'start', href: '/', text: 'Start' },
      { key: 'lernen', href: '/lernen', text: 'Lernen' },
      { key: 'gespraech', href: '/gespraech', text: 'Gespräch' },
      { key: 'kunden', href: '/kunden', text: 'Kunden' },
      { key: 'kalender', href: '/kalender', text: 'Kalender' },
      ...(preiseSichtbar ? [{ key: 'preisrechner', href: '/preisrechner', text: 'Preisrechner' }] : []),
      { key: 'provision', href: '/provision', text: 'Provision' },
      ...(benutzer.rolle === 'admin' ? [{ key: 'admin', href: '/admin', text: 'Admin' }] : []),
    ]
  : [];
// Briefing-Boegen haengen an einem Kunden und stehen darum unter Kunden.
const hauptAktiv = aktiv === 'briefing' ? 'kunden' : aktiv;

// Unterpunkte je Bereich. Aktiv ist der laengste passende Pfad.
const UNTERPUNKTE: Record<string, Punkt[]> = {
  kunden: [
    { key: '/kunden', href: '/kunden', text: 'Meine Kunden' },
    { key: '/kunden/wiedervorlagen', href: '/kunden/wiedervorlagen', text: 'Wiedervorlagen' },
    { key: '/briefing', href: '/briefing', text: 'Briefing-Bögen' },
  ],
  admin: [
    { key: '/admin', href: '/admin', text: 'Start' },
    { key: '/admin/uebersicht', href: '/admin/uebersicht', text: 'Übersicht' },
    { key: '/admin/vertriebler', href: '/admin/vertriebler', text: 'Vertriebler' },
    { key: '/admin/kunden', href: '/admin/kunden', text: 'Alle Kunden' },
    { key: '/admin/provision', href: '/admin/provision', text: 'Provision' },
    { key: '/admin/briefings', href: '/admin/briefings', text: 'Briefing-Bögen' },
    { key: '/admin/dubletten', href: '/admin/dubletten', text: 'Dubletten' },
    { key: '/admin/protokoll', href: '/admin/protokoll', text: 'Protokoll' },
  ],
};
const unterpunkte = benutzer ? (UNTERPUNKTE[hauptAktiv] ?? []) : [];
const unterAktiv = unterpunkte
  .filter((u) => pfad === u.key || pfad.startsWith(`${u.key}/`))
  .sort((x, y) => y.key.length - x.key.length)[0]?.key;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light dark" />
    <title>{titel} | dekaru Partner-Portal</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Gespeicherten Modus setzen, bevor etwas gezeichnet wird. Eigene Datei wegen der CSP. -->
    <script is:inline src="/theme-init.js"></script>
  </head>
  <body>
    <header class="kopf">
      <div class="kopf__zeile">
        <a class="marke" href="/">dekaru <span>Partner-Portal</span></a>
        <div class="kopf__person">
          <button type="button" class="modus" data-modus aria-pressed="false" aria-label="Dunkler Modus" title="Hell oder dunkel">
            <svg class="modus__sonne" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
            </svg>
            <svg class="modus__mond" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
          </button>
          {
            benutzer && (
              <details class="konto" data-konto>
                <summary class="konto__knopf">
                  <span class="konto__name">{benutzer.name}</span>
                  <span class="konto__kurz" aria-hidden="true">{benutzer.name.trim().charAt(0).toUpperCase() || '?'}</span>
                  <span class="sr-only">Konto-Menü</span>
                </summary>
                <div class="konto__menue">
                  <p class="konto__wer">{benutzer.name}<br /><span>{benutzer.email}</span></p>
                  <a href="/einstellungen" aria-current={aktiv === 'einstellungen' ? 'page' : undefined}>Einstellungen</a>
                  <a href="/passwort">Passwort ändern</a>
                  <form method="post" action="/logout">
                    <input type="hidden" name="_csrf" value={csrf} />
                    <button type="submit">Abmelden</button>
                  </form>
                </div>
              </details>
            )
          }
        </div>
      </div>
      {
        punkte.length > 0 && (
          <nav class="nav" aria-label="Hauptnavigation">
            {punkte.map((p) => (
              <a href={p.href} aria-current={p.key === hauptAktiv ? 'page' : undefined}>
                {p.text}
              </a>
            ))}
          </nav>
        )
      }
      {
        unterpunkte.length > 0 && (
          <nav class="unternav" aria-label={hauptAktiv === 'admin' ? 'Admin-Bereich' : 'Kunden-Bereich'}>
            {unterpunkte.map((u) => (
              <a href={u.href} aria-current={u.key === unterAktiv ? 'page' : undefined}>
                {u.text}
              </a>
            ))}
          </nav>
        )
      }
    </header>
    <main class:list={{ schmal }}>
      <slot />
    </main>
    <footer class="fuss">
      <div class="fuss__zeile">
        <span>dekaru Partner-Portal, Michael Henning Consulting</span>
        <a href="/datenschutz">Datenschutz</a>
      </div>
    </footer>
    <script>
      import '../scripts/modus.ts';
      import '../scripts/kopf.ts';
    </script>
  </body>
</html>
