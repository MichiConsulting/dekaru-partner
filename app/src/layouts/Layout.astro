---
import '../styles/global.css';

interface Props {
  titel: string;
  aktiv?: 'start' | 'lernen' | 'gespraech' | 'kunden' | 'provision' | 'admin' | 'keine';
  schmal?: boolean;
}

const { titel, aktiv = 'keine', schmal = false } = Astro.props;
const benutzer = Astro.locals.benutzer;
const csrf = Astro.locals.csrf ?? '';

const punkte = benutzer
  ? [
      { key: 'start', href: '/', text: 'Start' },
      { key: 'lernen', href: '/lernen', text: 'Lernen' },
      { key: 'gespraech', href: '/gespraech', text: 'Gespräch' },
      { key: 'kunden', href: '/kunden', text: 'Meine Kunden' },
      { key: 'provision', href: '/provision', text: 'Meine Provision' },
      ...(benutzer.rolle === 'admin' ? [{ key: 'admin', href: '/admin', text: 'Admin' }] : []),
    ]
  : [];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light dark" />
    <title>{titel} | dekaru Partner-Portal</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Gespeicherten Modus setzen, bevor etwas gezeichnet wird. Eigene Datei wegen der CSP. -->
    <script is:inline src="/theme-init.js"></script>
  </head>
  <body>
    <header class="kopf">
      <div class="kopf__zeile">
        <a class="marke" href="/">dekaru <span>Partner-Portal</span></a>
        <div class="kopf__person">
          {benutzer && <span class="name">{benutzer.name}</span>}
          <button type="button" class="modus" data-modus aria-pressed="false" aria-label="Dunkler Modus" title="Hell oder dunkel">
            <svg class="modus__sonne" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
            </svg>
            <svg class="modus__mond" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
          </button>
          {
            benutzer && (
              <form method="post" action="/logout" class="inline">
                <input type="hidden" name="_csrf" value={csrf} />
                <button type="submit" class="btn btn--zweit btn--klein">
                  Abmelden
                </button>
              </form>
            )
          }
        </div>
      </div>
      {
        punkte.length > 0 && (
          <nav class="nav" aria-label="Hauptnavigation">
            {punkte.map((p) => (
              <a href={p.href} aria-current={p.key === aktiv ? 'page' : undefined}>
                {p.text}
              </a>
            ))}
          </nav>
        )
      }
    </header>
    <main class:list={{ schmal }}>
      <slot />
    </main>
    <footer class="fuss">
      <div class="fuss__zeile">
        <span>dekaru Partner-Portal, Michael Henning Consulting</span>
        <a href="/datenschutz">Datenschutz</a>
      </div>
    </footer>
    <script>
      import '../scripts/modus.ts';
    </script>
  </body>
</html>
