---
// Das Schema fuer das Erstgespraech, gemeinsam fuer zwei Seiten:
//   /erstgespraech  im Portal, nur fuer angemeldete Vertriebler
//   /schema         oeffentliche Fassung zum Nachschicken nach dem Termin
//
// Alle Texte entstehen hier auf dem Server. Das Skript im Browser schaltet nur
// um (Schritt, Branche, Paket, Praesentation) und kennt keine Preise.
// Ohne JavaScript stehen alle Schritte untereinander.
//
// Diese Komponente liest bewusst nichts aus Astro.locals: auf /schema gibt es
// keine Sitzung, und es soll nie ein Name aus dem Portal auftauchen.
// Die Kopfleiste ueber den Schritten (Hinweise, Knoepfe) kommt als Slot
// "leiste" von der jeweiligen Seite.
import '../styles/schema-farben.css';
import '../styles/schema.css';
import ModulSchema from './ModulSchema.astro';
import ModulSchemaSymbole from './ModulSchemaSymbole.astro';
import { BRANCHEN, BRANCHEN_IDS, PAKETE_MIT_FUNKTION, PAKET_REIHE, PREISANGABEN, anzahlBausteine, bausteine, type Branche } from '../lib/schema.ts';
import { MODULE_PAKETE, MODULE_PAKET_NAME, PAKETE } from '../lib/preise.ts';
import { modulAbschnitte, verfuegbareModule } from '../lib/schema-module.ts';
import { moduleAusAdresse, moduleFuerAdresse } from '../lib/module.ts';
import {
  FARBGRUPPEN,
  GRUPPE_INSPIRIERT,
  HINWEIS_NAMEN,
  SCHEMA_ZU_TEMPLATE,
  empfohlenePaletten,
  farbfelder,
  gruppeFuerSchema,
  gruppenStreifen,
  paletteFuerSchema,
  paletteTitel,
  palettenBranche,
  palettenDerGruppe,
  probeStil,
  schemaDaten,
  zusatzZeile,
} from '../lib/paletten.ts';

interface Props {
  branche: Branche;
  /** Pfad der Seite, auf die die Branchen-Links ohne JavaScript fuehren. */
  basis: '/erstgespraech' | '/schema';
}

const { branche, basis } = Astro.props;
// Gewaehlte Farbpalette und offene Farbgruppe aus der Adresse
// (?palette=BL-2&gruppe=BL). Jede Palette gilt fuer jede Branche. Gespeichert
// wird nichts. Ohne JavaScript fuehren Links genau hierher.
const gewaehlt = paletteFuerSchema(Astro.url.searchParams.get('palette'));
const offeneGruppe = gruppeFuerSchema(Astro.url.searchParams.get('gruppe'));
// Vorgemerkte Software-Module (?module=kostenrechner), wie die Palette nur
// in der Adresse. Eine Merkliste fuer das Gespraech, keine Bestellung.
const gewaehlteModule = moduleAusAdresse(Astro.url.searchParams.get('module'));
const adresse = (bid: string, gruppe: string | null, palette: string | null, module: string[], schritt: number) => {
  const q = new URLSearchParams({ branche: bid });
  if (gruppe) q.set('gruppe', gruppe);
  if (palette) q.set('palette', palette);
  if (module.length) q.set('module', moduleFuerAdresse(module));
  return `${basis}?${q.toString()}#schritt-${schritt}`;
};
const farbLink = (bid: string, gruppe: string | null, palette: string | null) => adresse(bid, gruppe, palette, gewaehlteModule, 3);
// Link ohne JavaScript: schaltet ein Modul in der Merkliste um.
const modulLink = (bid: string, schluessel: string) => {
  const neu = gewaehlteModule.includes(schluessel) ? gewaehlteModule.filter((s) => s !== schluessel) : [...gewaehlteModule, schluessel];
  // Reihenfolge wie in der Modulliste, damit der Link immer gleich aussieht.
  return adresse(bid, offeneGruppe?.kuerzel ?? null, gewaehlt?.code ?? null, alleModule.map((m) => m.schluessel).filter((s) => neu.includes(s)), 4);
};
// Kompakte Paletten-Daten fuer das Skript (Karten einer Gruppe ohne Neuladen).
const datenJson = JSON.stringify(schemaDaten()).replace(/</g, '\\u003c');
const standardVorschau = palettenBranche(SCHEMA_ZU_TEMPLATE[branche.id])?.standard ?? '';
const PAKET_START = 'gross';

const SCHRITTE = ['Überblick', 'Heute', 'Bausteine', 'Farben', 'Funktion', 'Datenweg', 'Weiter'];

// Kurzzeilen je Paket. Bewusst eigene Saetze: die Beschreibungen in
// preise.json sind teils in Michis Ich-Form.
const PAKET_ZEILE: Record<string, string> = {
  klein: 'Eine Seite, die alles Wichtige sagt.',
  mittel: 'Eigene Seiten für Leistungen, Bilder und Bewertungen, dazu geschriebene Texte.',
  gross: 'Wie Mittel, dazu mehr Seiten, Ihr Team, aufbereitete Fotos und die mitarbeitende Funktion.',
};

const varianten = BRANCHEN_IDS.map((id) => {
  const b = BRANCHEN[id];
  const liste = bausteine(b);
  // Gleiche Beschriftungen mehrerer Pakete zusammenfassen: eine Zeile mit data-fuer="mittel gross".
  const kacheln = liste.map((k) => {
    const gruppen = new Map<string, string[]>();
    for (const p of PAKET_REIHE) {
      const text = k.je[p];
      if (text === null) continue;
      gruppen.set(text, [...(gruppen.get(text) ?? []), p]);
    }
    return { ...k, in: PAKET_REIHE.filter((p) => k.je[p] !== null).join(' '), texte: [...gruppen].map(([text, pakete]) => ({ text, fuer: pakete.join(' ') })) };
  });
  return { b, kacheln, abschnitte: modulAbschnitte(id), empfohlen: empfohlenePaletten(SCHEMA_ZU_TEMPLATE[id]) };
});
// Alle verkaufbaren Module, in jeder Branche gleich (nur die Reihenfolge der Empfehlung wechselt).
const alleModule = verfuegbareModule(branche.id);
const auswahlNamen = alleModule.filter((m) => gewaehlteModule.includes(m.schluessel)).map((m) => m.name);
const anzahl = Object.fromEntries(PAKET_REIHE.map((p) => [p, anzahlBausteine(varianten[0].kacheln, p)]));
const paketMitFunktion = PAKETE_MIT_FUNKTION.join(' und ');
---

<div class="schema" data-schema data-branche={branche.id} data-paket={PAKET_START} data-palette={gewaehlt?.code ?? ''} data-gruppe={offeneGruppe?.kuerzel ?? ''} data-merkliste={moduleFuerAdresse(gewaehlteModule)}>
  <div class="schema__leiste">
    <slot name="leiste" />
  </div>

  <nav class="schema__punkte nur-js" aria-label="Schritte">
    <ol>
      {
        SCHRITTE.map((s, i) => (
          <li>
            <button type="button" data-gehe={i} aria-label={`Schritt ${i + 1}: ${s}`}>
              <span class="schema__nr" aria-hidden="true">{i + 1}</span>
              <span class="schema__punkt-text" aria-hidden="true">{s}</span>
            </button>
          </li>
        ))
      }
    </ol>
  </nav>
  <p class="sr-only" aria-live="polite" data-ansage></p>

  <div class="schema__buehne" data-buehne>
    <!-- 0: Start und Branche -->
    <section class="schritt schritt--start" id="schritt-0" data-schritt="0" aria-labelledby="t-0">
      <p class="schritt__marke">Ihre Website im Überblick</p>
      <h1 id="t-0" class="schritt__titel" tabindex="-1">Was eine Website Ihrem Betrieb abnehmen kann</h1>
      <p class="schritt__lead">Ein kurzer Überblick in sechs Schritten. Keine fertige Seite, sondern eine Skizze: woraus Ihre Website besteht, in welchen Farben sie erscheinen kann, was sie Ihnen abnimmt und wie es danach weitergeht.</p>
      <p class="schritt__frage" id="branche-frage">Für welche Art von Betrieb?</p>
      <ul class="branchen" aria-labelledby="branche-frage">
        {
          BRANCHEN_IDS.map((id, i) => (
            <li style={`--i:${i}`}>
              <a
                class:list={['branche', `branche--${id}`]}
                href={`${basis}?branche=${id}#schritt-1`}
                data-branche-wahl={id}
                aria-current={id === branche.id ? 'true' : undefined}
              >
                <span class="branche__name">{BRANCHEN[id].name}</span>
                <span class="branche__bsp">{BRANCHEN[id].beispiele}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 1: Der Betrieb heute -->
    <section class="schritt schritt--heute" id="schritt-1" data-schritt="1" aria-labelledby="t-1">
      <p class="schritt__marke">Schritt 1 von 6</p>
      <h2 id="t-1" class="schritt__titel" tabindex="-1">Ihr Betrieb heute</h2>
      {
        varianten.map(({ b }) => (
          <div data-fuer-branche={b.id} hidden={b.id !== branche.id}>
            <p class="schritt__lead">Ein ganz normaler Arbeitstag. Kommt Ihnen etwas davon bekannt vor?</p>
            <div class="heute">
              <div class="heute__telefon" aria-hidden="true">
                <svg viewBox="0 0 64 64" width="64" height="64" focusable="false">
                  <rect x="18" y="6" width="28" height="52" rx="5" fill="var(--sc-orange-flaeche)" stroke="var(--sc-orange-rand)" stroke-width="3" />
                  <rect x="24" y="14" width="16" height="26" rx="1.5" fill="var(--sc-orange-rand)" opacity=".35" />
                  <circle cx="32" cy="49" r="3" fill="var(--sc-orange-rand)" />
                  <path class="heute__welle" d="M8 22c-3 6-3 14 0 20M56 22c3 6 3 14 0 20" fill="none" stroke="var(--sc-orange-rand)" stroke-width="3" stroke-linecap="round" />
                </svg>
              </div>
              <ul class="karten karten--orange">
                {b.heute.map((p, i) => (
                  <li class="karte-sc" style={`--i:${i}`}>
                    <strong>{p.titel}</strong>
                    <span>{p.text}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </section>

    <!-- 2: Bausteine -->
    <section class="schritt schritt--bausteine" id="schritt-2" data-schritt="2" aria-labelledby="t-2">
      <p class="schritt__marke">Schritt 2 von 6</p>
      <h2 id="t-2" class="schritt__titel" tabindex="-1">Die Website setzt sich zusammen</h2>
      <p class="schritt__lead">Jede Website besteht aus Bausteinen. Drei Pakete, jedes mit festem Inhalt. Je größer das Paket, desto mehr Bausteine.</p>
      <div class="pakete-wahl nur-js" role="group" aria-label="Paket zeigen">
        {
          PAKETE.map((p) => (
            <button type="button" data-paket-wahl={p.schluessel} data-anzahl={anzahl[p.schluessel]} aria-pressed={p.schluessel === PAKET_START ? 'true' : 'false'}>
              <span class="pakete-wahl__name">{p.name}</span>
              <span class="pakete-wahl__zahl">{anzahl[p.schluessel]} Bausteine</span>
            </button>
          ))
        }
      </div>
      {
        PAKETE.map((p) => (
          <p class="pakete-zeile" data-fuer-paket={p.schluessel}>
            <strong>{p.name}:</strong> {PAKET_ZEILE[p.schluessel] ?? p.beschreibung}
          </p>
        ))
      }
      <p class="sr-only" aria-live="polite" data-paket-ansage></p>
      {
        varianten.map(({ b, kacheln }) => (
          <ul class="bausteine" data-fuer-branche={b.id} hidden={b.id !== branche.id}>
            {kacheln.map((k, i) => (
              <li class:list={['baustein', `baustein--${k.gruppe}`]} data-in={k.in} style={`--i:${i}`}>
                {k.texte.map((t) => (
                  <span data-fuer={t.fuer}>{t.text}</span>
                ))}
              </li>
            ))}
          </ul>
        ))
      }
      {
        // Software-Module gibt es nur mit Paket Gross. Kein Baustein (sie sind
        // nicht im Paket enthalten und aendern die Zahl der Bausteine nicht),
        // sondern eine Zeile, die nur beim Paket Gross erscheint (CSS). Seit
        // 06.10.2026 in jeder Branche dieselbe Zeile.
        alleModule.length > 0 && (
          <p class="bausteine-module" data-in={MODULE_PAKETE.join(' ')}>
            <strong>Nur im Paket {MODULE_PAKET_NAME} dazu wählbar, in jeder Branche:</strong> {alleModule.map((m) => m.name).join(', ')}. Mehr dazu in Schritt 4.
          </p>
        )
      }
      <ul class="legende" aria-label="Farben der Bausteine">
        <li><span class="legende__farbe baustein--grund" aria-hidden="true"></span>In jedem Paket</li>
        <li><span class="legende__farbe baustein--inhalt" aria-hidden="true"></span>Mehr Inhalt</li>
        <li><span class="legende__farbe baustein--sichtbar" aria-hidden="true"></span>Besser gefunden werden</li>
        <li><span class="legende__farbe baustein--funktion" aria-hidden="true"></span>Arbeitet mit</li>
      </ul>
    </section>

    <!-- 3: Farben. Ebene 1 Farbgruppen, Ebene 2 die Paletten einer Gruppe.
         Ohne JavaScript ueber Links (?gruppe=BL, ?palette=BL-2), mit
         JavaScript ohne Neuladen aus den Daten in data-paletten-daten. -->
    <section class="schritt schritt--farben" id="schritt-3" data-schritt="3" aria-labelledby="t-3">
      <p class="schritt__marke">Schritt 3 von 6</p>
      <h2 id="t-3" class="schritt__titel" tabindex="-1">In welchen Farben?</h2>
      <p class="schritt__lead">Über hundert fertige Farbwelten in {FARBGRUPPEN.length} Gruppen. Jede ist auf gute Lesbarkeit geprüft, auf dem Handy wie am Rechner. Wählen Sie erst eine Farbgruppe, dann eine Palette.</p>
      {(() => {
        const vorschau = (gewaehlt ?? paletteFuerSchema(standardVorschau))!;
        return (
          <div class="farbwahl">
            <div class="farbprobe" style={probeStil(vorschau)} data-farb-vorschau aria-hidden="true">
              <div class="farbprobe__kopf">
                <span class="farbprobe__marke">Ihr Betrieb</span>
                <span class="farbprobe__nav"><span>Leistungen</span><span>Kontakt</span></span>
              </div>
              <div class="farbprobe__inhalt">
                <span class="farbprobe__titel">So wirkt Ihre Startseite</span>
                <span class="farbprobe__text">Ein Absatz Fließtext, wie er auf der Seite steht. Dazu ein <span class="farbprobe__link">Link zum Weiterlesen</span>.</span>
                <span class="farbprobe__knoepfe">
                  <span class="probe-knopf probe-knopf--haupt">Anfrage senden</span>
                  <span class="probe-knopf probe-knopf--zweit">Mehr erfahren</span>
                </span>
              </div>
            </div>
            <div class="farbwahl__name" data-farb-anzeige>
              <p class="farbwahl__code" data-farb-titel>{gewaehlt ? paletteTitel(gewaehlt) : 'Noch keine Palette gewählt'}</p>
              <p class="farbwahl__hinweis" data-farb-hinweis>{gewaehlt ? 'Diesen Namen bitte nennen.' : `Die Vorschau zeigt ${paletteTitel(vorschau)}. Wählen Sie unten eine Palette.`}</p>
            </div>
          </div>
        );
      })()}

      {
        varianten.map(({ b, empfohlen }) => (
          <div class="empfehlung" data-fuer-branche={b.id} hidden={b.id !== branche.id}>
            <p class="empfehlung__titel">Passt oft zu Ihrer Branche</p>
            <ul class="empfehlung__liste">
              {empfohlen.map((p) => (
                <li>
                  <a
                    class="chip"
                    href={farbLink(b.id, p.gruppe, p.code)}
                    data-palette-wahl={p.code}
                    data-gruppe-ziel={p.gruppe}
                    aria-current={gewaehlt?.code === p.code ? 'true' : undefined}
                  >
                    <span class="chip__felder" aria-hidden="true">
                      {farbfelder(p).slice(0, 3).map((f) => (
                        <span style={`background:${f.farbe}`} />
                      ))}
                    </span>
                    <span class="chip__code">{p.code}</span> {p.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div class="farbgruppen-bereich" data-gruppen-uebersicht hidden={Boolean(offeneGruppe)}>
        <p class="schritt__frage" id="farbgruppen-frage">Farbgruppen</p>
        <ul class="farbgruppen" aria-labelledby="farbgruppen-frage">
          {FARBGRUPPEN.map((g, i) => (
            <li style={`--i:${i}`}>
              <a class="farbgruppe" href={farbLink(branche.id, g.kuerzel, gewaehlt?.code ?? null)} data-gruppe-wahl={g.kuerzel}>
                <span class="farbgruppe__streifen" style={`background:${gruppenStreifen(g)}`} aria-hidden="true" />
                <span class="farbgruppe__kopf">
                  <span class="farbgruppe__name">{g.label}</span>
                  <span class="farbgruppe__zahl">{g.codes.length} Paletten</span>
                </span>
                <span class="farbgruppe__text">{g.beschreibung}</span>
                <span class="farbgruppe__wahl" data-gruppe-gewaehlt={g.kuerzel} hidden={gewaehlt?.gruppe !== g.kuerzel}>Ihre Wahl liegt hier</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="farbgruppe-ansicht" data-gruppen-ansicht hidden={!offeneGruppe}>
        <div class="farbgruppe-ansicht__kopf">
          <a class="btn btn--zweit btn--klein" href={farbLink(branche.id, null, gewaehlt?.code ?? null)} data-gruppe-zurueck>Alle Farbgruppen</a>
          <h3 class="farbgruppe-ansicht__titel" tabindex="-1" data-gruppe-titel>{offeneGruppe?.label ?? ''}</h3>
        </div>
        <ul class="paletten" aria-labelledby="t-3" data-paletten-liste>
          {offeneGruppe &&
            palettenDerGruppe(offeneGruppe).map((p, i) => (
              <li style={`--i:${i}`}>
                <a
                  class="palette"
                  href={farbLink(branche.id, offeneGruppe.kuerzel, p.code)}
                  data-palette-wahl={p.code}
                  aria-current={gewaehlt?.code === p.code ? 'true' : undefined}
                >
                  <span class="palette__probe" style={probeStil(p)} aria-hidden="true">
                    <span class="palette__felder">
                      {farbfelder(p).map((f) => (
                        <span class="palette__feld" style={`background:${f.farbe}`} />
                      ))}
                    </span>
                    <span class="palette__muster">
                      <span class="palette__ueberschrift">Überschrift</span>
                      <span class="palette__zeile">Text auf der Fläche</span>
                      <span class="palette__knoepfe">
                        <span class="probe-knopf probe-knopf--haupt">Anfragen</span>
                        <span class="probe-knopf probe-knopf--zweit">Mehr</span>
                      </span>
                    </span>
                  </span>
                  <span class="palette__fuss">
                    <span class="palette__code">{p.code}</span>
                    <span class="palette__name">{p.name}</span>
                    <span class="palette__charakter">{p.charakter}</span>
                    {zusatzZeile(p) && <span class="palette__zusatz">{zusatzZeile(p)}</span>}
                    <span class="palette__gewaehlt">Gewählt</span>
                  </span>
                </a>
              </li>
            ))}
        </ul>
        <p class="schritt__klein" data-hinweis-namen hidden={offeneGruppe?.kuerzel !== GRUPPE_INSPIRIERT}>{HINWEIS_NAMEN}</p>
      </div>

      <template data-karten-vorlage>
        <li>
          <a class="palette" href="#schritt-3" data-palette-wahl="">
            <span class="palette__probe" aria-hidden="true">
              <span class="palette__felder">
                <span class="palette__feld"></span><span class="palette__feld"></span><span class="palette__feld"></span><span class="palette__feld"></span><span class="palette__feld"></span>
              </span>
              <span class="palette__muster">
                <span class="palette__ueberschrift">Überschrift</span>
                <span class="palette__zeile">Text auf der Fläche</span>
                <span class="palette__knoepfe">
                  <span class="probe-knopf probe-knopf--haupt">Anfragen</span>
                  <span class="probe-knopf probe-knopf--zweit">Mehr</span>
                </span>
              </span>
            </span>
            <span class="palette__fuss">
              <span class="palette__code"></span>
              <span class="palette__name"></span>
              <span class="palette__charakter"></span>
              <span class="palette__zusatz"></span>
              <span class="palette__gewaehlt">Gewählt</span>
            </span>
          </a>
        </li>
      </template>
      <script is:inline type="application/json" data-paletten-daten set:html={datenJson} />

      <p class="sr-only" aria-live="polite" data-farb-ansage></p>
      <p class="schritt__klein">Sie müssen sich heute nicht festlegen. Hat Ihr Betrieb schon feste Farben, etwa im Logo, sprechen Sie das im Termin an.</p>
      <p class="schritt__klein" data-hinweis-namen-immer>Zur Gruppe „Inspiriert von bekannten Websites“: {HINWEIS_NAMEN}</p>
    </section>

    <!-- 4: Die mitarbeitende Funktion -->
    <section class="schritt schritt--funktion" id="schritt-4" data-schritt="4" aria-labelledby="t-4">
      <p class="schritt__marke">Schritt 4 von 6</p>
      <h2 id="t-4" class="schritt__titel" tabindex="-1">Die Website arbeitet mit</h2>
      {
        varianten.map(({ b }) => (
          <div data-fuer-branche={b.id} hidden={b.id !== branche.id}>
            <p class="schritt__lead">
              Im Paket {paketMitFunktion} nimmt Ihnen die Website eine Aufgabe ab: die <strong>{b.funktion}</strong>.
            </p>
            <div class="ablauf">
              <div class="ablauf__kasten ablauf__kasten--formular" style="--i:0">
                <p class="ablauf__kopf">{b.besucher} trägt ein</p>
                <ul class="formular-skizze">
                  {b.felder.map((f) => (
                    <li>{f}</li>
                  ))}
                </ul>
              </div>
              <div class="ablauf__pfeil" aria-hidden="true">
                <svg viewBox="0 0 48 24" width="48" height="24" focusable="false">
                  <path d="M2 12h40M34 4l8 8-8 8" fill="none" stroke="var(--sc-gruen-rand)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
              <div class="ablauf__kasten ablauf__kasten--mail" style="--i:1">
                <p class="ablauf__kopf">Bei Ihnen kommt eine Mail an</p>
                <p class="mail-skizze">
                  <span class="mail-skizze__zeit">{b.beispielAnfrage.zeit}</span>
                  <span>{b.beispielAnfrage.text}</span>
                </p>
                <p class="ablauf__fuss">Sie antworten und bestätigen, wann es passt.</p>
              </div>
            </div>
            <ul class="karten karten--gruen">
              {b.abnahme.map((p, i) => (
                <li class="karte-sc" style={`--i:${i + 2}`}>
                  <strong>{p.titel}</strong>
                  <span>{p.text}</span>
                </li>
              ))}
            </ul>
            <p class="schritt__klein">Eine Anfrage ist keine feste Buchung: Sie entscheiden und melden sich zurück. Die Funktion gibt es nur im Paket {paketMitFunktion} und solange die Website bei Michael Henning gehostet wird.</p>
          </div>
        ))
      }
      {
        // Verkaufbare Software-Module (lib/module.ts), seit 06.10.2026 in jeder
        // Branche. Nur zum Paket Gross, deshalb hier beim Paket mit der
        // mitarbeitenden Funktion. Die Empfehlung der Branche steht zuerst,
        // die uebrigen darunter. Nur Name und Nutzen, kein Preis. Vormerken
        // ist eine Merkliste in der Adresse (?module=), gespeichert wird nichts.
        alleModule.length > 0 && (
          <div class="module" data-module>
            <ModulSchemaSymbole />
            <p class="ablauf__kopf">Im Paket {MODULE_PAKET_NAME} zusätzlich möglich</p>
            {varianten.map(({ b, abschnitte }) => (
              <div data-fuer-branche={b.id} hidden={b.id !== branche.id}>
                {abschnitte.map((a) => (
                  <div class:list={['module__abschnitt', a.empfohlen && 'module__abschnitt--empfohlen']}>
                    <p class="empfehlung__titel">{a.titel}</p>
                    {a.gruppen.map((g) => (
                      <>
                        {g.titel && <p class="module__gruppe">{g.titel}</p>}
                        <ul class="karten karten--blau">
                          {g.module.map((m, i) => (
                            <li class="karte-sc modul-karte" style={`--i:${i + 5}`}>
                              <details class="modul-so">
                                <summary>
                                  <ModulSchema kurz={m.kurz} />
                                  <strong class="modul-so__name">{m.name}</strong>
                                  <span class="modul-so__nutzen">{m.nutzen}</span>
                                  <span class="modul-so__knopf">So funktioniert es</span>
                                </summary>
                                <ol class="modul-so__schritte">
                                  {m.soGehts.map((s) => (
                                    <li>{s}</li>
                                  ))}
                                </ol>
                              </details>
                              <a
                                class="modul-wahl"
                                role="button"
                                href={modulLink(b.id, m.schluessel)}
                                data-modul-wahl={m.kurz}
                                data-modul-name={m.name}
                                aria-pressed={gewaehlteModule.includes(m.schluessel) ? 'true' : 'false'}
                                aria-label={`${m.name} vormerken`}
                              >
                                <span class="modul-wahl__kasten" aria-hidden="true"></span>
                                <span class="modul-wahl__text">Vormerken</span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </>
                    ))}
                  </div>
                ))}
              </div>
            ))}
            <div class="module__auswahl" data-modul-auswahl>
              <p>
                <strong>Ihre Auswahl:</strong> <span data-modul-auswahl-text>{auswahlNamen.length ? auswahlNamen.join(', ') : 'Noch nichts vorgemerkt.'}</span>
              </p>
              <p class="schritt__klein">Nur eine Merkliste für das Gespräch. Gespeichert wird nichts, die Auswahl steht nur in der Adresse dieser Seite.</p>
            </div>
            <p class="sr-only" aria-live="polite" data-modul-ansage></p>
            <p class="schritt__klein">Software, die zusätzlich mitarbeitet. Jedes Modul ist in jeder Branche wählbar. Einmal gekauft und von Michael Henning für Sie eingerichtet, nur zu einer Website im Paket {MODULE_PAKET_NAME}.</p>
          </div>
        )
      }
    </section>

    <!-- 5: Der Weg der Daten -->
    <section class="schritt schritt--weg" id="schritt-5" data-schritt="5" aria-labelledby="t-5">
      <p class="schritt__marke">Schritt 5 von 6</p>
      <h2 id="t-5" class="schritt__titel" tabindex="-1">Welchen Weg eine Anfrage nimmt</h2>
      <p class="schritt__lead">Wohin gehen die Angaben, die jemand ins Formular schreibt? Genau diesen Weg, verschlüsselt:</p>
      <ol class="weg">
        <li class="weg__station weg__station--besucher" style="--i:0">
          <span class="weg__nr" aria-hidden="true">1</span>
          <strong>Formular auf Ihrer Website</strong>
          <span>Ein Besucher schreibt seine Anfrage und schickt sie ab.</span>
        </li>
        <li class="weg__linie weg__linie--1" aria-hidden="true"><span class="weg__brief"></span></li>
        <li class="weg__station weg__station--dienst" style="--i:1">
          <span class="weg__nr" aria-hidden="true">2</span>
          <strong>Formulardienst von dekaru</strong>
          <span>Server in Frankfurt. Prüft die Anfrage auf Spam und leitet sie weiter.</span>
        </li>
        <li class="weg__linie weg__linie--2" aria-hidden="true"><span class="weg__brief"></span></li>
        <li class="weg__station weg__station--postfach" style="--i:2">
          <span class="weg__nr" aria-hidden="true">3</span>
          <strong>Mail in Ihrem Postfach</strong>
          <span>Sie antworten direkt an den Absender.</span>
        </li>
      </ol>
      <div class="weg__nichts" style="--i:3">
        <svg viewBox="0 0 40 40" width="40" height="40" aria-hidden="true" focusable="false">
          <ellipse cx="20" cy="10" rx="12" ry="5" fill="none" stroke="var(--sc-gelb-rand)" stroke-width="2.5" />
          <path d="M8 10v20c0 2.8 5.4 5 12 5s12-2.2 12-5V10" fill="none" stroke="var(--sc-gelb-rand)" stroke-width="2.5" />
          <path d="M4 36 36 4" stroke="var(--sc-gelb-text)" stroke-width="3" stroke-linecap="round" />
        </svg>
        <p><strong>Beim Formulardienst wird der Inhalt der Anfrage nicht gespeichert.</strong> Keine Datenbank, keine Kopie an dekaru. Die Anfrage liegt danach nur in Ihrem Postfach.</p>
      </div>
      {
        varianten.map(({ b }) =>
          b.datenHinweis ? (
            <p class="schritt__klein" data-fuer-branche={b.id} hidden={b.id !== branche.id}>
              {b.datenHinweis}
            </p>
          ) : null,
        )
      }
    </section>

    <!-- 6: Wie es weitergeht -->
    <section class="schritt schritt--weiter" id="schritt-6" data-schritt="6" aria-labelledby="t-6">
      <p class="schritt__marke">Schritt 6 von 6</p>
      <h2 id="t-6" class="schritt__titel" tabindex="-1">Wie es weitergeht</h2>
      <ol class="zeitstrahl">
        <li style="--i:0"><strong>Heute</strong><span>Sie erzählen, was Ihr Betrieb braucht und was Sie schon haben: Fotos, Texte, Logo.</span></li>
        <li style="--i:1"><strong>Die Vorschau</strong><span>Michael Henning baut eine Vorschau Ihrer Website, mit Ihren echten Daten.</span></li>
        <li style="--i:2"><strong>Zweiter Termin</strong><span>Wir schauen die Vorschau gemeinsam an. Sie sagen, was passt und was nicht.</span></li>
        <li style="--i:3"><strong>Angebot</strong><span>Mit festem Preis und Fertigstellungstermin. Erst dann entscheiden Sie.</span></li>
      </ol>
      <div class="preise">
        <div class="preis preis--website" style="--i:4">
          <span class="preis__was">Website, einmalig</span>
          <span class="preis__zahl">{PREISANGABEN.website}</span>
        </div>
        <div class="preis preis--hosting" style="--i:5">
          <span class="preis__was">Hosting und Pflege, optional</span>
          <span class="preis__zahl">{PREISANGABEN.hosting}</span>
        </div>
        <p class="preis preis--quartal" style="--i:6"><strong>Gratisquartal.</strong> {PREISANGABEN.gratisquartal}</p>
      </div>
      <p class="schritt__klein">Den genauen Preis für Ihren Betrieb erfahren Sie im zweiten Termin, zusammen mit der Vorschau.</p>
    </section>
  </div>

  <div class="schema__steuer nur-js">
    <button type="button" class="btn btn--zweit" data-zurueck>Zurück</button>
    <button type="button" class="schema__nochmal" data-nochmal>Noch einmal abspielen</button>
    <button type="button" class="btn" data-weiter>Weiter</button>
  </div>
</div>
